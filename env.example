# This file is a template. The project reads real environment variables,
# it does not load this file automatically.
#
# Local development works without any of these variables because
# DJANGO_ENV defaults to "development" and DEBUG defaults to True.

# Local development
# DJANGO_ENV=development
# DEBUG=True

# Production (Render or any other host)
DJANGO_ENV=production
DEBUG=False
SECRET_KEY=replace-with-a-long-random-secret-key
ALLOWED_HOSTS=example.com,www.example.com,.onrender.com
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com,https://*.onrender.com

# Secret admin path. Do not use "admin". Generate a unique value for production,
# for example: ADMIN_URL=boshqaruv-8f4c2d9a/
ADMIN_URL=boshqaruv-7f3c9a/

# Security (enable only after HTTPS is configured)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False

# Database (Render PostgreSQL, Neon, Supabase, etc.)
# DATABASE_URL=postgresql://user:password@host:5432/database

# Shop / contact
SHIPPING_COST=15000
CONTACT_EMAIL=behruzjalolov13@gmail.com
DEFAULT_FROM_EMAIL=MultiShop <behruzjalolov13@gmail.com>

# Gmail SMTP. EMAIL_HOST_PASSWORD must be a Google "App password",
# not the normal Gmail password. If it is set, the SMTP backend is used
# automatically; otherwise development uses the console backend.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=behruzjalolov13@gmail.com
# EMAIL_HOST_PASSWORD=your-16-character-google-app-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
