# Local development defaults. Copy to backend/.env for local overrides.
DJANGO_ENV=development
DEBUG=True
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CSRF_TRUSTED_ORIGINS=

# Optional PostgreSQL (production). SQLite is used when this is empty.
# DATABASE_URL=postgresql://taskflow:password@localhost:5432/taskflow
DATABASE_URL=

# Set these only when serving production traffic behind HTTPS.
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
